# ==============================================================================
# HoneyChain Web3 Middleware Configuration Template
# Copy this file to .env and configure your environment variables.
# ==============================================================================

# Network and RPC
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Private key for middleware server-side transactions (Default Hardhat Dev Account #0)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed Smart Contract Addresses
HONEY_BATCH_NFT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
HONEY_ESCROW_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ZK_VERIFIER_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# IPFS & Pinata Storage (Server-Side Only — Never Expose to Frontend)
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
# Set to 'true' to force offline mock CID generation in tests
MOCK_IPFS=false

# Modular Zero-Knowledge Prover
ZK_PROVER_URL=http://localhost:8080
ZK_CIRCUIT_NAME=HoneyQualityCircuit

# REST API Gateway
PORT=3000
NODE_ENV=development
